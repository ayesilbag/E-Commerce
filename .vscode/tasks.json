{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "build",
            "command": "dotnet",
            "type": "process",
            "args": [
                "build",
                "${workspaceFolder}/ECommerce.sln",
                "/property:GenerateFullPaths=true",
                "/consoleloggerparameters:NoSummary;ForceNoAlign"
            ],
            "options": {
                "env": {
                    "MSBuildSDKsPath": "C:\\Program Files\\dotnet\\sdk\\9.0.310\\Sdks"
                }
            },
            "problemMatcher": "$msCompile"
        },
        {
            "label": "publish",
            "command": "dotnet",
            "type": "process",
            "args": [
                "publish",
                "${workspaceFolder}/ECommerce.sln",
                "/property:GenerateFullPaths=true",
                "/consoleloggerparameters:NoSummary;ForceNoAlign"
            ],
            "options": {
                "env": {
                    "MSBuildSDKsPath": "C:\\Program Files\\dotnet\\sdk\\9.0.310\\Sdks"
                }
            },
            "problemMatcher": "$msCompile"
        },
        {
            "label": "watch",
            "command": "dotnet",
            "type": "process",
            "args": [
                "watch",
                "run",
                "--project",
                "${workspaceFolder}/ECommerce.sln"
            ],
            "options": {
                "env": {
                    "MSBuildSDKsPath": "C:\\Program Files\\dotnet\\sdk\\9.0.310\\Sdks"
                }
            },
            "problemMatcher": "$msCompile"
        }
